# Copie este arquivo para .env e preencha com os valores do seu projeto.
# NUNCA faça commit do arquivo .env (veja .gitignore).

# --- Supabase (servidor) ---
# URL e chave publicável do projeto Supabase. Usadas pelo servidor (SSR /
# server functions) e repassadas ao cliente autenticado através do
# middleware de auth (src/integrations/supabase/auth-middleware.ts).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chave service_role — bypassa RLS. Usada SOMENTE em
# src/integrations/supabase/client.server.ts, nunca em código enviado ao
# navegador. Trate como segredo crítico.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (cliente / build-time, Vite) ---
# Mesmos valores de URL e chave publicável acima, expostos ao bundle do
# navegador (prefixo VITE_ obrigatório para o Vite injetar em build-time).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- OpenRouter (LLM) ---
# Nome preferido. Se ausente, o código também aceita a variável legada
# OPEN_ROUTER_API por compatibilidade — defina apenas uma das duas.
OPENROUTER_API_KEY=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
